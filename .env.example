# =============================================================================
# SOL Reclaim — environment variables
# Copy to .env.local for local dev. Set the same keys in Vercel for production.
# =============================================================================

# Required — server-side only (never exposed to browsers)
# Free tier: https://helius.dev
HELIUS_API_KEY=your_helius_api_key_here

# Required — public Solana address that receives the 1% platform fee
# (Also baked into src/lib/solana/constants.ts — do not remove)
NEXT_PUBLIC_FEE_WALLET=8SHY8J3gy6L9aaZzmQdR4JJTgZXBH3ArkJVWKw1ES9eH

# Optional — override RPC URL (otherwise built from HELIUS_API_KEY)
# SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Optional — public HTTP RPC for wallet WebSocket fallback (defaults to publicnode)
# NEXT_PUBLIC_RPC_URL=https://solana-rpc.publicnode.com

# Turnstile — bot check on wallet scan (dashboard: Cloudflare → Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAEN73ypJrJaLKLL2
TURNSTILE_SECRET=your_turnstile_secret_from_cloudflare_dashboard
TURNSTILE_HOSTNAMES=localhost,127.0.0.1,solreclaim.app,www.solreclaim.app,sol.sparky2ste.workers.dev
